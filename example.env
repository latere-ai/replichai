# Copy to .env and fill in. .env is gitignored — never commit a credential.

# Managed execution runtime and its namespaced credential.
REPLICHAI_RUNTIME=anthropic-managed
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# GitHub: creating, pushing, and granting reproduction repositories under the
# organisation. A token that can create a repo and push to it. For a real
# deployment this is the org admin token / a GitHub App; for the mount spike a
# classic PAT with the `repo` scope is enough.
REPLICHAI_GITHUB_TOKEN=
REPLICHAI_GITHUB_OWNER=open-hai

# Outbound mail (006p): the project invitation. Nothing here is required — with
# no transport configured the server logs the message instead of sending it, so
# a local run needs no credentials and no network.
#
# Mailgun, when the key is a real one ("test" and empty both select the log).
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=

# SMTP, used when no Mailgun key is set. Port 587 (STARTTLS) is the default;
# 465 selects implicit TLS. Plaintext delivery is not offered.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@latere.ai

# Where the app lives. Every link in an outbound message is built from it, so a
# wrong value sends people to the wrong host.
BASE_URL=http://localhost:8080

# --- Running sessions on this machine (045) ---------------------------------
# The local runtime needs none of these to work: with no configuration it uses
# the srt sandbox around the harness already installed and logged in here.
#
# REPLICHAI_SANDBOX=host                  # host (srt) or container (podman, docker)
# REPLICHAI_HARNESS=claude-code           # claude-code or codex
# REPLICHAI_CONTAINER_ENGINE=podman       # with the container sandbox
# REPLICHAI_HARNESS_IMAGE=                # override the harness image
# REPLICHAI_MODELS_FILE=~/.config/replichai/models.yaml
# REPLICHAI_SESSION_ROOT=~/.replichai/sessions
# REPLICHAI_SESSION_RETENTION=keep        # keep, on-failure, or discard

# --- The terminal talking to this deployment (045i, 045j) -------------------
# The CLI signs in here and presents a bearer the server verifies. A server
# with no AUTH_ISSUER refuses every bearer rather than accepting an unverified
# one, and serves the browser's cookie path unchanged.
#
# REPLICHAI_AUTH_URL=https://auth.latere.ai
# REPLICHAI_API_URL=https://replichai.latere.ai
# AUTH_JWKS_URL=                          # defaults to $AUTH_ISSUER/.well-known/jwks.json
# REPLICHAI_TOKEN_AUDIENCE=replichai.latere.ai
