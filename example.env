# Copy to .env and fill in. .env is gitignored and .dockerignore keeps it out of
# the image build, so a credential in it stays on this machine. Never commit
# one. Blank values are secrets. A commented-out line is a setting whose
# default works; uncomment it to change the default.
#
# Who reads this file: `make up` substitutes ${VAR} in docker-compose.yml from
# it; deploy/README.md turns it into the cluster's replichai-config secret,
# where the manifests set every policy value and only the credentials should be
# filled in; the CLI reads the REPLICHAI_* names from your shell. Comments stay
# on their own lines because `kubectl create secret --from-env-file` would put
# an inline comment into the value.

# ── The server ────────────────────────────────────────────────────────────────

# Listen address.
ADDR=:8080
# The public URL of the app. Every link in an outbound message is built from it,
# so a wrong value sends people to the wrong host.
BASE_URL=http://localhost:8080
# Postgres URL on the direct endpoint. Blank uses in-memory stores; compose and
# the cluster set their own. Migrations always run on this one.
DATABASE_URL=
# Postgres URL on the pooler's endpoint, which serving traffic opens. Blank
# serves on DATABASE_URL, which is what a local run and compose do.
DATABASE_POOL_URL=
# Which runtime runs sessions: memory, which is free and produces a fake audit;
# anthropic-managed; latere; or local. The CLI honors it too, and --runtime
# overrides it. On the server it is the runtime a session that names none runs on.
REPLICHAI_RUNTIME=memory
# Server only: the runtimes a person may choose when they start a session, as a
# comma list beside REPLICHAI_RUNTIME, for example latere. local is never
# offered by a server.
# REPLICHAI_RUNTIMES=latere
# The method directory. Blank discovers ./method from the working directory.
# METHOD_DIR=
# A directory of published reproductions to serve as the registry. Blank is an
# empty registry.
# REPRO_DIR=
# Dev only: a pause per phase so the SSE stream is watchable rather than instant.
# RUNNER_DELAY=1500ms
# Dev only: admit every request as a synthetic principal instead of signing in.
# Refused off loopback, and never set in a deployment.
# DEV=true
# Dev only: allow DEV on a bind that is not loopback. Compose needs it because
# the container binds all interfaces; nothing else should set it.
# DEV_INSECURE=true

# ── Runtime credentials ───────────────────────────────────────────────────────
# Each runtime reads only its own names, so a key can never reach a runtime it
# was not meant for.

# anthropic-managed: the Managed Agents credential.
ANTHROPIC_API_KEY=
# anthropic-managed: a non-default API endpoint.
# ANTHROPIC_BASE_URL=

# latere: the platform's API origin and its Auth, blank for production.
# LATERE_API_URL=
# LATERE_AUTH_URL=
# latere, command line only: a personal access token from the Latere console,
# or a command that prints a bearer for api.latere.ai. Either acts as you, and
# your own Latere wallet pays. Under DEV the server acts as you through the
# command; outside DEV it ignores both.
# LATERE_API_KEY=
# LATERE_TOKEN_COMMAND=
# latere, server: a 32-byte key as 64 hex characters that seals each person's
# kept Latere sign-in. Required when REPLICHAI_RUNTIMES offers latere, together
# with AUTH_CLIENT_SECRET.
# REPLICHAI_SIGNIN_KEY=

# ── Signing in through the browser (OIDC) ─────────────────────────────────────
# All of these are required in production; locally the dev bypass above stands in.

# The OIDC issuer. The terminal's bearer tokens are verified against it too.
AUTH_ISSUER=https://auth.latere.ai
# The one audience the server's bearer path accepts, the actor token the CLI
# mints for this server; required whenever AUTH_ISSUER is set.
AUTH_AUDIENCE=replichai.latere.ai
# The issuer's key set; defaults to $AUTH_ISSUER/.well-known/jwks.json.
# AUTH_JWKS_URL=https://auth.latere.ai/.well-known/jwks.json
# The client registered with the issuer for this BASE_URL.
AUTH_CLIENT_ID=
# Only for a confidential client. A public PKCE client leaves it blank.
AUTH_CLIENT_SECRET=
# The redirect registered on that client. Blank uses $BASE_URL/callback.
AUTH_REDIRECT_URL=
# Signs the session cookie. Generate one with: openssl rand -hex 32
AUTH_COOKIE_KEY=
# The issuer's OIDC variant. latere is the default.
# AUTH_PROVIDER=latere
# Comma-separated. Seeded as platform admins at every start, which is how the
# first admin exists before there is anyone to promote them; a revoked address
# is skipped, so a restart does not undo a ban.
ADMIN_EMAILS=

# ── The terminal talking to this deployment ───────────────────────────────────
# The CLI signs in at REPLICHAI_AUTH_URL and presents a bearer to
# REPLICHAI_API_URL; the server verifies it against the issuer's signing keys.
# A server with no AUTH_ISSUER refuses every bearer rather than trusting one.

# CLI: where `replichai login` signs in.
# REPLICHAI_AUTH_URL=https://auth.latere.ai
# CLI: the deployment that `push`, `project` and `login` talk to.
# REPLICHAI_API_URL=https://replichai.latere.ai

# ── GitHub: the repositories reproductions are published into ─────────────────
# A GitHub App is preferred: it alone can mint the short-lived, one-repository
# token a run pushes with. With neither an App nor a token the server runs
# audits without a repository and keeps only the transcript.

# The App's numeric id.
REPLICHAI_GITHUB_APP_ID=
# The App's private key: the PEM text itself, or a path to the .pem file.
REPLICHAI_GITHUB_APP_KEY=
# The fallback: a personal access token that can create and push to
# repositories under the owner. The CLI's --publish uses it when no --project
# is given.
REPLICHAI_GITHUB_TOKEN=
# The organization the repositories are created under.
REPLICHAI_GITHUB_OWNER=open-hai
# The GitHub API root the CLI talks to. Blank is api.github.com; a test or a
# GitHub Enterprise deployment points it elsewhere.
REPLICHAI_GITHUB_API_URL=

# ── Card payments ─────────────────────────────────────────────────────────────
# Blank selects a refusing adapter: the app boots and checkout answers
# payments_unconfigured. Sessions are metered either way; without card payments,
# credits come only from an admin.

STRIPE_SECRET_KEY=
# Verifies the webhook, which is the only path that posts a credit.
STRIPE_WEBHOOK_SECRET=

# ── Drafting a project description ────────────────────────────────────────────

# Only for a drafting endpoint that is not Anthropic's; on Anthropic the
# ANTHROPIC_API_KEY above is reused. The model itself is an admin setting.
DRAFT_API_KEY=

# ── Outbound mail: the project invitation ─────────────────────────────────────
# Nothing here is required. With no transport configured the server logs each
# message instead of sending it, so a local run needs no credentials.

# A real key sends. Blank, or the literal `test`, selects the log transport.
MAILGUN_API_KEY=
# Required when a key is set: a key with no domain fails at startup, on purpose.
MAILGUN_DOMAIN=
# eu selects the EU API host; anything else selects the US one.
MAILGUN_REGION=
# SMTP is used only when no Mailgun key is set.
SMTP_HOST=
# 587 with STARTTLS is the default; 465 selects implicit TLS. Plaintext is not offered.
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# The sender on every message.
SMTP_FROM=noreply@latere.ai

# ── Running sessions on this machine (--runtime local) ────────────────────────
# None of these is needed: with no configuration the srt sandbox wraps the
# harness already installed and logged in here. The server reads the same
# names when REPLICHAI_RUNTIME=local.

# host, which uses srt, or container, which uses podman or docker.
# REPLICHAI_SANDBOX=host
# claude-code or codex.
# REPLICHAI_HARNESS=claude-code
# With the container sandbox: podman or docker. Blank tries podman, then docker.
# REPLICHAI_CONTAINER_ENGINE=
# With the container sandbox: the harness image. Required there, because no
# harness image is published to fall back to.
# REPLICHAI_HARNESS_IMAGE=
# Gateways and models. Blank means the harness's own login.
# REPLICHAI_MODELS_FILE=~/.config/replichai/models.yaml
# Where session directories are made.
# REPLICHAI_SESSION_ROOT=~/.replichai/sessions
# keep, on-failure, or discard a session directory after release.
# REPLICHAI_SESSION_RETENTION=keep

# ── Tests ─────────────────────────────────────────────────────────────────────
# For a developer's shell, never for a deployment's .env.

# Runs the Postgres store contracts. Point it at a scratch database, never the
# dev one; `make db-contract` does.
# TEST_DATABASE_URL=
# Runs the real local-runtime end-to-end tests, which launch a paid agent session.
# REPLICHAI_E2E=1
