# A local .env holds credentials; example.env is the template for it. The build
# stage runs COPY . ., so without this rule .env would land in the image layers
# and in the GitHub Actions build cache. Only example.env, which holds no
# credentials, enters the build context.
.env
*.env
!example.env
# The image rebuilds the frontend, so local dependencies and build output stay out.
frontend/node_modules
internal/spa/dist
