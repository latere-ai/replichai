#!/bin/sh
# pre-push: runs golangci-lint over the packages this push changes, so a lint
# finding is seen before CI rather than fixed in a follow-up commit. The check
# lives in lateregate; this file only calls it. Refs arrive on stdin once, so a
# check added below must read $refs, not stdin.
refs=$(cat)
printf '%s\n' "$refs" | go tool lateregate prepush || exit 1
